antly":[60,69],"##How to Copy Without Incrementing#5\\. Use Ctrl + Enter to Fill Multiple Cells Instantly#{1}":[62,69],"##How to Copy Without Incrementing#6\\. Disable Fill Handle (If Auto-Increment Annoys You Often)":[70,79],"##How to Copy Without Incrementing#6\\. Disable Fill Handle (If Auto-Increment Annoys You Often)#{1}":[72,79],"##Final Thoughts":[80,84],"##Final Thoughts#{1}":[82,84]},"outlinks":[],"metadata":{"created":"2026-07-27","updated":"2026-08-02","source":"Mastering Excel: How to Copy Without Incrementing","source_url":"https://medium.com/@markchen69/mastering-excel-how-to-copy-without-incrementing-65a4b508d22b","note_type":"source","tags":["#excel"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"01.Knowledge/Excel/Wiki/excel-copy-without-incrementing.md"},
