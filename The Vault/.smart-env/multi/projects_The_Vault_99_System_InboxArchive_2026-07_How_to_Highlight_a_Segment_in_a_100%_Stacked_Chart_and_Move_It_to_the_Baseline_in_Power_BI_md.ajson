],"##Wiring it up in the report#Add the selector slicer:#{1}":[190,192],"##Wiring it up in the report#Colors & legend — see Block 3 above.":[193,196],"##Wiring it up in the report#Colors & legend — see Block 3 above.#{1}":[195,196],"##Optional — a custom tooltip":[197,258],"##Optional — a custom tooltip#{1}":[199,258],"##Quick test checklist":[259,269],"##Quick test checklist#{1}":[261,269],"##Why this method?":[270,274],"##Why this method?#{1}":[272,274]},"outlinks":[{"title":"Iwa Sanjaya","target":"Iwa Sanjaya","line":5},{"title":"Power BI Report","target":"https://app.powerbi.com/view?r=eyJrIjoiYmRiN2QzNjYtMDNlNi00NTdmLTg0MmItNjIyNTViODg2NWQ2IiwidCI6ImRmODY3OWNkLWE4MGUtNDVkOC05OWFjLWM4M2VkN2ZmOTVhMCJ9&source=post_page-----fbb68f3dade6---------------------------------------","line":19},{"title":"**Buy Me a Coffee**","target":"https://buymeacoffee.com/powerlib","line":274},{"title":"**Ko-Fi**","target":"https://ko-fi.com/powerlib","line":274},{"title":"**website**","target":"https://powerlib.super.site/","line":274},{"title":"LinkedIn","target":"https://www.linkedin.com/in/iwasanjaya/","line":274},{"title":"email","target":"mailto:hello.powerlib@gmail.com","line":274}],"metadata":{"title":"How to Highlight a Segment in a 100% Stacked Chart and Move It to the Baseline in Power BI","source":"https://medium.com/@iwasanjaya/how-to-highlight-a-segment-in-a-100-stacked-chart-and-move-it-to-the-baseline-in-power-bi-fbb68f3dade6","author":["[[Iwa Sanjaya]]"],"published":"2026-07-27","created":"2026-07-27","description":"Let the reader pick which segment is easy to read — it drops to the baseline in color, everything else fades to grey. Works on any category with 2 or more segments (status, size, material, whatever you stack).","Processed":"Unprocessed"},"task_lines":[],"tasks":{},"codeblock_ranges":[[81,92],[110,117],[131,136],[140,151],[207,210],[214,223],[229,239],[243,246]],"key":"projects/The Vault/99.System/InboxArchive/2026-07/How to Highlight a Segment in a 100% Sta