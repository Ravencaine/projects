4,75],"##1\\. Measure validation — the auditor’s power tool":[76,97],"##1\\. Measure validation — the auditor’s power tool#{1}":[78,97],"##2\\. Relationship and data-quality validation":[98,103],"##2\\. Relationship and data-quality validation#{1}":[100,103],"##3\\. Living documentation":[104,107],"##3\\. Living documentation#{1}":[106,107],"##A Worked Example: The Reconciliation Notebook":[108,169],"##A Worked Example: The Reconciliation Notebook#{1}":[110,169],"##SemPy vs. Semantic-Link-Labs":[170,178],"##SemPy vs. Semantic-Link-Labs#{1}":[172,178],"##What It Won’t Do":[179,187],"##What It Won’t Do#{1}":[181,187],"##Practitioner Verdict":[188,201],"##Practitioner Verdict#{1}":[191,201]},"outlinks":[{"title":"reports-semantic-models-power-bi-service","target":"reports-semantic-models-power-bi-service","line":200}],"metadata":{"created":"2026-07-27","source":"The Python Library That Reads Your Power BI Models Like Data. Most Fabric Teams Have Never Opened It.","source_url":"https://medium.com/towards-artificial-intelligence/the-python-library-that-reads-your-power-bi-models-like-data-a8aa1408f2cd","note_type":"source","tags":["#power-bi"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[41,67],[80,94],[112,158]],"key":"projects/The Vault/01.Knowledge/Power BI/Wiki/sempysemantic-link-power-bi-fabric.md"},
