2},{"title":"Lets know more about the 3–30–300 Rules.","target":"https://medium.com/@mdrahmanmizan/the-3-30-300-rule-changed-the-way-i-build-dashboards-91f261df3780","line":49},{"title":"Power BI Newsletter","target":"https://medium.com/microsoft-power-bi/newsletters/microsoft-power-bi-weekly","line":55}],"class_name":"SmartBlock"},
